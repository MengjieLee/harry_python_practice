   "source": [
    "def clim(n):\n",
    "    if n <= 2:\n",
    "        return n\n",
    "    pre, cur = 1, 2\n",
    "    for i in range(3, n+1):\n",
    "        pre, cur = cur, cur + pre\n",
    "    return cur\n",
    "\n",
    "clim(5)"
   ]
  }
